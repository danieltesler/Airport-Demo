# Copy to .env.local and fill in. .env.local is git-ignored and must never be committed.
# Do NOT put real keys in THIS file — it is committed as a template.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional overrides (sensible defaults shown)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
MAX_AGENT_STEPS=6

# Optional voice overrides (defaults shown; match the defaults in app/api/stt and app/api/tts)
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Optional: ElevenLabs voice. When BOTH the key and the voice id are set it speaks; OpenAI
# above stays the automatic fallback. Server-side only: never prefix these with NEXT_PUBLIC_.
# Pick a voice id with: node --env-file=.env.local scripts/list-elevenlabs-voices.mjs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Credit guards (defaults shown): max characters per request, per client per hour, per day, parallel calls.
# ELEVENLABS_MAX_CHARS=600
# ELEVENLABS_CLIENT_CHARS_PER_HOUR=3000
# ELEVENLABS_CHARS_PER_DAY=8000
# ELEVENLABS_MAX_CONCURRENT=3

# Optional: free Census Bureau key (https://api.census.gov/data/key_signup.html). Enables the
# metro_population tool; without it that tool reports it is not configured. Server-side only.
CENSUS_API_KEY=
# CENSUS_ACS_YEAR=2024

# Optional: only needed if the API is hosted on a different origin than the UI.
# Leave empty for the single-app (same-origin) deployment.
# NEXT_PUBLIC_API_BASE_URL=

# Optional: hands-free Conversation mode (on|off). Unset = on in dev, off in production.
# NEXT_PUBLIC_CONVERSATION_MODE=on
