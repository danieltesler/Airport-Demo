# Copy to .env.local and fill in. .env.local is git-ignored and must never be committed.
# Do NOT put real keys in THIS file — it is committed as a template.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional overrides (sensible defaults shown)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
MAX_AGENT_STEPS=4

# Optional voice overrides (defaults shown; match the defaults in app/api/stt and app/api/tts)
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Optional: ElevenLabs voice. When BOTH the key and the voice id are set it speaks; OpenAI
# above stays the automatic fallback. Server-side only: never prefix these with NEXT_PUBLIC_.
# Pick a voice id with: node --env-file=.env.local scripts/list-elevenlabs-voices.mjs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Credit guards (defaults shown): max characters per request, per client per hour, per day, parallel calls.
# ELEVENLABS_MAX_CHARS=600
# ELEVENLABS_CLIENT_CHARS_PER_HOUR=3000
# ELEVENLABS_CHARS_PER_DAY=8000
# ELEVENLABS_MAX_CONCURRENT=3

# Optional: only needed if the API is hosted on a different origin than the UI.
# Leave empty for the single-app (same-origin) deployment.
# NEXT_PUBLIC_API_BASE_URL=

# Hands-free Conversation mode is ON by default. Set to "off" at build time to hide the Conversation button.
# NEXT_PUBLIC_CONVERSATION_MODE=off

# Sign in with Google (see README "Authentication"). Leave AUTH_REQUIRED unset or "false" and the app is open, exactly as before.
# Set it to "true" and /api/chat, /api/stt and /api/tts accept only signed-in users. It is the on/off switch.
AUTH_REQUIRED=false
# Signs our own session JWTs (HS256). 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everybody out.
AUTH_SECRET=
# This app's public origin; the Google redirect URI is built from it (never from the request's Host header).
# Production: https://airport-demo-pi.vercel.app   Local: http://localhost:3000 (the default outside production)
AUTH_URL=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Server-side only: never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
